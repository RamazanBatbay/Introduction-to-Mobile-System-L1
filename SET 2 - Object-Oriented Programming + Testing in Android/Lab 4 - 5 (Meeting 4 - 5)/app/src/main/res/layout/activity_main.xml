<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_lamp_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lamp_status_off"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_intensity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Intensity: 0"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_bulb_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bulb_status_ok"
        android:textSize="18sp"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_turn_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_turn_on"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btn_turn_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_turn_off" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_brighten"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_brighten"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btn_dim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_dim" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_replace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_replace"
        android:layout_marginBottom="24dp" />

    <!-- NEW TEST RUNNER UI -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_run_tests"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Run All Tests"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#222222"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_test_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test results will appear here."
            android:textColor="#FFFFFF"
            android:fontFamily="monospace"
            android:textSize="14sp" />
    </ScrollView>

</LinearLayout>
